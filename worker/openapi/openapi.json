{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Actions",
    "version": "1.0.0",
    "description": "Read-only BTCUSDT market snapshot and deterministic plan validation."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "TradePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "entry",
          "stop",
          "targets",
          "leverage",
          "marginMode"
        ],
        "properties": {
          "side": { "type": "string", "enum": ["LONG", "SHORT"] },
          "entry": { "type": "number", "exclusiveMinimum": 0 },
          "stop": { "type": "number", "exclusiveMinimum": 0 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "maxLossUsdt": { "type": "number", "exclusiveMinimum": 0 },
          "accountEquity": { "type": "number", "exclusiveMinimum": 0 },
          "riskPercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "entryOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "exitOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "expectedFundingPeriods": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "default": 0
          },
          "leverage": { "type": "integer", "const": 10 },
          "marginMode": { "type": "string", "const": "ISOLATED" }
        }
      }
    }
  },
  "security": [{ "actionKey": [] }],
  "paths": {
    "/v1/snapshot/latest": {
      "get": {
        "operationId": "getLatestSnapshot",
        "summary": "Get the latest validated BTCUSDT snapshot",
        "x-openai-isConsequential": false,
        "responses": {
          "200": { "description": "Latest snapshot" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "No snapshot" }
        }
      }
    },
    "/v1/plan/validate": {
      "post": {
        "operationId": "validateTradePlan",
        "summary": "Validate a manual 10x isolated trade plan",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TradePlan" }
            }
          }
        },
        "responses": {
          "200": { "description": "Validated calculation" },
          "400": { "description": "Invalid plan" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
