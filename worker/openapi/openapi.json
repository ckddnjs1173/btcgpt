{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Actions",
    "version": "5.1.0",
    "description": "Read-only BTCUSDT schema v5 market, context, lifecycle, and deterministic calculation actions."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        },
        "additionalProperties": true
      },
      "ValidationFailure": {
        "type": "object",
        "required": ["ok", "errors", "warnings"],
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "errors": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "DecisionGates": {
        "type": "object",
        "required": [
          "marketAnalysisAvailable",
          "entryAllowed",
          "positionManagementAvailable",
          "quality",
          "generatedAt",
          "publishedAt",
          "ageMs",
          "marketDataAgeMs",
          "relayPublishAgeMs",
          "criticalBlockers",
          "degradedSources",
          "missingFields"
        ],
        "properties": {
          "marketAnalysisAvailable": { "type": "boolean" },
          "entryAllowed": { "type": "boolean" },
          "positionManagementAvailable": { "type": "boolean" },
          "quality": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
          "generatedAt": { "type": "integer" },
          "publishedAt": { "type": ["integer", "null"] },
          "ageMs": { "type": "number" },
          "marketDataAgeMs": { "type": "number" },
          "relayPublishAgeMs": { "type": ["number", "null"] },
          "criticalBlockers": { "type": "array", "items": { "type": "string" } },
          "degradedSources": { "type": "array", "items": { "type": "string" } },
          "missingFields": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "WebSocketHealth": {
        "type": "object",
        "required": ["status", "connected", "lastConnectedAt", "lastEventAt", "reconnectCount", "consecutiveFailures", "errorCode"],
        "properties": {
          "status": { "type": "string", "enum": ["CONNECTED", "DISCONNECTED"] },
          "connected": { "type": "boolean" },
          "lastConnectedAt": { "type": ["integer", "null"] },
          "lastEventAt": { "type": ["integer", "null"] },
          "reconnectCount": { "type": "integer" },
          "consecutiveFailures": { "type": "integer" },
          "errorCode": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "MarketSnapshot": {
        "type": "object",
        "required": ["schemaVersion", "appVersion", "snapshotId", "symbol", "market", "generatedAt", "decisionGates", "connections", "marketState", "orderFlow", "sourceHealth", "timeframes", "trading"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 5 },
          "appVersion": { "type": "string" },
          "snapshotId": { "type": "string" },
          "symbol": { "type": "string", "const": "BTCUSDT" },
          "market": { "type": "string", "const": "BINANCE_USDM_PERPETUAL" },
          "generatedAt": { "type": "integer" },
          "generatedAtKst": { "type": "string" },
          "relayReceivedAt": { "type": "integer" },
          "decisionGates": { "$ref": "#/components/schemas/DecisionGates" },
          "connections": {
            "type": "object",
            "required": ["publicWebSocket", "marketWebSocket"],
            "properties": {
              "publicWebSocket": { "$ref": "#/components/schemas/WebSocketHealth" },
              "marketWebSocket": { "$ref": "#/components/schemas/WebSocketHealth" }
            }
          },
          "strategy": { "type": "object", "additionalProperties": true },
          "marketState": { "type": "object", "additionalProperties": true },
          "orderFlow": {
            "type": "object",
            "required": ["orderBookSynchronized", "orderBookSyncState", "orderBookLevelCount"],
            "properties": {
              "orderBookSynchronized": { "type": "boolean" },
              "orderBookSyncState": { "type": "string", "enum": ["FETCHING_SNAPSHOT", "WAITING_FOR_BRIDGE", "SYNCHRONIZED", "RETRY_SCHEDULED"] },
              "orderBookLevelCount": { "type": "integer", "minimum": 0 },
              "sessionCvd": { "type": "number" },
              "rollingCvd4h": { "type": "number" }
            },
            "additionalProperties": true
          },
          "openInterest": { "type": "object", "additionalProperties": true },
          "sentiment": { "type": "object", "additionalProperties": true },
          "liquidations": { "type": "object", "additionalProperties": true },
          "position": { "type": "object", "additionalProperties": true },
          "account": { "type": "object", "additionalProperties": true },
          "costSettings": { "type": "object", "additionalProperties": true },
          "productFilters": { "type": ["object", "null"], "additionalProperties": true },
          "sourceHealth": { "type": "object", "additionalProperties": true },
          "timeframes": { "type": "object", "additionalProperties": true },
          "riskContext": { "type": "object", "additionalProperties": true },
          "scalpContext": { "type": "object", "additionalProperties": true },
          "trading": { "$ref": "#/components/schemas/TradingState" }
        },
        "additionalProperties": true
      },
      "ExternalContext": {
        "type": "object",
        "required": ["schemaVersion", "generatedAt", "status", "horizon", "items", "sourceHealth", "riskContext"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "generatedAt": { "type": "integer" },
          "relayReceivedAt": { "type": "integer" },
          "ageMs": { "type": "number" },
          "status": { "type": "string" },
          "horizon": { "type": "string", "enum": ["INTRADAY", "SWING", "MACRO"] },
          "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "sourceHealth": { "type": "object", "additionalProperties": true },
          "riskContext": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "TradePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "entry", "stop", "targets", "sizeMode", "sizeValue", "leverage", "marginMode"],
        "properties": {
          "snapshotId": {
            "type": "string",
            "description": "Snapshot used for the decision. Supply getLatestSnapshot.snapshotId so validation can detect a changed market snapshot."
          },
          "side": { "type": "string", "enum": ["LONG", "SHORT"] },
          "entry": { "type": "number", "exclusiveMinimum": 0 },
          "stop": { "type": "number", "exclusiveMinimum": 0 },
          "targets": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "maxLossUsdt": { "type": "number", "exclusiveMinimum": 0 },
          "riskPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "entryOrderType": { "type": "string", "enum": ["MAKER", "TAKER"], "default": "TAKER" },
          "exitOrderType": { "type": "string", "enum": ["MAKER", "TAKER"], "default": "TAKER" },
          "expectedFundingPeriods": { "type": "integer", "minimum": 0, "maximum": 12, "default": 0 },
          "sizeMode": { "type": "string", "enum": ["MARGIN_USDT", "QUANTITY_BTC", "NOTIONAL_USDT", "MAX_LOSS_USDT"] },
          "sizeValue": { "type": "number", "exclusiveMinimum": 0 },
          "leverage": { "type": "integer", "minimum": 1, "maximum": 150, "default": 10 },
          "marginMode": { "type": "string", "const": "ISOLATED" }
        }
      },
      "PlanValidationResponse": {
        "type": "object",
        "required": ["ok", "errors", "warnings", "quantity", "initialMargin", "targets", "calculationSource"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "errors": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "quantity": { "type": ["number", "null"] },
          "maxLoss": { "type": ["number", "null"] },
          "estimatedMaxLoss": { "type": ["number", "null"] },
          "notional": { "type": ["number", "null"] },
          "initialMargin": { "type": ["number", "null"] },
          "requestedQuantity": { "type": "number" },
          "estimatedLiquidationPrice": { "type": ["number", "null"] },
          "liquidationDistancePercent": { "type": ["number", "null"] },
          "maximumAllowed": { "type": "object", "additionalProperties": true },
          "targets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "calculationSource": {
            "type": "object",
            "required": ["snapshotId", "generatedAt", "productFilters", "feeRates", "slippage", "fundingRate"],
            "properties": {
              "snapshotId": { "type": ["string", "null"] },
              "generatedAt": { "type": "integer" },
              "productFilters": { "type": "object", "additionalProperties": true },
              "feeRates": { "type": "object", "additionalProperties": true },
              "slippage": { "type": "object", "additionalProperties": true },
              "fundingRate": { "type": "number" }
            }
          }
        },
        "additionalProperties": true
      },
      "TradingState": {
        "type": "object",
        "required": ["mode", "lifecycle", "liveManual"],
        "properties": {
          "mode": { "type": "string", "enum": ["PAPER", "LIVE_MANUAL"] },
          "lifecycle": {
            "type": "object",
            "required": ["stage", "mode", "planId", "tradeId", "positionSource", "startedAt", "updatedAt", "blockedReasons"],
            "properties": {
              "stage": { "type": "string", "enum": ["FLAT", "WATCHING", "ENTRY_READY", "MANAGING", "CLOSED", "CANCELLED"] },
              "mode": { "type": "string", "enum": ["PAPER", "LIVE_MANUAL"] },
              "planId": { "type": ["string", "null"] },
              "tradeId": { "type": ["string", "null"] },
              "positionSource": { "type": "string", "enum": ["NONE", "PAPER", "BINANCE_READ_ONLY"] },
              "startedAt": { "type": ["integer", "null"] },
              "updatedAt": { "type": "integer" },
              "blockedReasons": { "type": "array", "items": { "type": "string" } }
            }
          },
          "liveManual": { "type": "object", "additionalProperties": true },
          "generatedAt": { "type": "integer" },
          "relayReceivedAt": { "type": "integer" },
          "ageMs": { "type": "number" },
          "relayStatus": { "type": "string", "enum": ["NORMAL", "DELAYED", "STALE"] }
        },
        "additionalProperties": true
      }
    }
  },
  "security": [
    { "actionKey": [] }
  ],
  "paths": {
    "/v1/snapshot/latest": {
      "get": {
        "operationId": "getLatestSnapshot",
        "summary": "Get the latest validated BTCUSDT snapshot",
        "x-openai-isConsequential": false,
        "responses": {
          "200": { "description": "Latest snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketSnapshot" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "No snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Storage unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/context/latest": {
      "get": {
        "operationId": "getExternalContext",
        "summary": "Get normalized external context",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["INTRADAY", "SWING", "MACRO"] }
          }
        ],
        "responses": {
          "200": { "description": "External context", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalContext" } } } },
          "400": { "description": "Invalid horizon", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "No context", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Storage unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/v1/plan/validate": {
      "post": {
        "operationId": "validateTradePlan",
        "summary": "Validate an exact-size 1 to 150x isolated manual plan",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TradePlan" } } }
        },
        "responses": {
          "200": { "description": "Validated calculation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanValidationResponse" } } } },
          "400": { "description": "Invalid plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationFailure" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "Current snapshot cannot validate this plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationFailure" } } } },
          "413": { "description": "Payload too large", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Storage unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationFailure" } } } }
        }
      }
    },
    "/v1/trading-state/latest": {
      "get": {
        "operationId": "getTradeLifecycle",
        "summary": "Get the latest manual or paper lifecycle state",
        "x-openai-isConsequential": false,
        "responses": {
          "200": { "description": "Lifecycle state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TradingState" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "No lifecycle state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "Storage unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  }
}
