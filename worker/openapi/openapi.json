{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Actions",
    "version": "5.2.0",
    "description": "Unified BTCUSDT market, context, lifecycle, deterministic calculation, and analytics-only GPT decision telemetry actions."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "ValidationFailure": {
        "type": "object",
        "required": ["ok", "errors", "warnings"],
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "errors": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "DecisionGates": {
        "type": "object",
        "required": [
          "marketAnalysisAvailable",
          "entryAllowed",
          "positionManagementAvailable",
          "quality",
          "criticalBlockers",
          "degradedSources",
          "missingFields"
        ],
        "properties": {
          "marketAnalysisAvailable": { "type": "boolean" },
          "entryAllowed": { "type": "boolean" },
          "positionManagementAvailable": { "type": "boolean" },
          "quality": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
          "generatedAt": { "type": "integer" },
          "publishedAt": { "type": ["integer", "null"] },
          "ageMs": { "type": "number" },
          "marketDataAgeMs": { "type": "number" },
          "relayPublishAgeMs": { "type": ["number", "null"] },
          "criticalBlockers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "degradedSources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missingFields": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      },
      "TradingState": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["PAPER", "LIVE_MANUAL"] },
          "lifecycle": {
            "type": "object",
            "additionalProperties": true
          },
          "liveManual": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAt": { "type": "integer" },
          "relayReceivedAt": { "type": "integer" },
          "ageMs": { "type": "number" },
          "relayStatus": {
            "type": "string",
            "enum": ["NORMAL", "DELAYED", "STALE"]
          }
        },
        "additionalProperties": true
      },
      "MarketSnapshot": {
        "type": "object",
        "required": [
          "schemaVersion",
          "appVersion",
          "snapshotId",
          "symbol",
          "market",
          "generatedAt",
          "decisionGates",
          "marketState",
          "orderFlow",
          "sourceHealth",
          "timeframes",
          "trading"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 5 },
          "appVersion": { "type": "string" },
          "snapshotId": { "type": "string" },
          "symbol": { "type": "string", "const": "BTCUSDT" },
          "market": { "type": "string", "const": "BINANCE_USDM_PERPETUAL" },
          "generatedAt": { "type": "integer" },
          "generatedAtKst": { "type": "string" },
          "relayReceivedAt": { "type": "integer" },
          "decisionGates": { "$ref": "#/components/schemas/DecisionGates" },
          "connections": {
            "type": "object",
            "additionalProperties": true
          },
          "strategy": {
            "type": "object",
            "additionalProperties": true
          },
          "marketState": {
            "type": "object",
            "additionalProperties": true
          },
          "orderFlow": {
            "type": "object",
            "additionalProperties": true
          },
          "openInterest": {
            "type": "object",
            "additionalProperties": true
          },
          "sentiment": {
            "type": "object",
            "additionalProperties": true
          },
          "liquidations": {
            "type": "object",
            "additionalProperties": true
          },
          "position": {
            "type": "object",
            "additionalProperties": true
          },
          "account": {
            "type": "object",
            "additionalProperties": true
          },
          "costSettings": {
            "type": "object",
            "additionalProperties": true
          },
          "productFilters": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "sourceHealth": {
            "type": "object",
            "additionalProperties": true
          },
          "timeframes": {
            "type": "object",
            "additionalProperties": true
          },
          "riskContext": {
            "type": "object",
            "additionalProperties": true
          },
          "scalpContext": {
            "type": "object",
            "additionalProperties": true
          },
          "trading": { "$ref": "#/components/schemas/TradingState" }
        },
        "additionalProperties": true
      },
      "ExternalContext": {
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "integer" },
          "generatedAt": { "type": "integer" },
          "relayReceivedAt": { "type": "integer" },
          "ageMs": { "type": "number" },
          "status": { "type": "string" },
          "horizon": {
            "type": "string",
            "enum": ["INTRADAY", "SWING", "MACRO"]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "sourceHealth": {
            "type": "object",
            "additionalProperties": true
          },
          "riskContext": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "TradePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "entry",
          "stop",
          "targets",
          "sizeMode",
          "sizeValue",
          "leverage",
          "marginMode"
        ],
        "properties": {
          "snapshotId": {
            "type": "string",
            "description": "Snapshot used for the decision. Supply getLatestSnapshot.snapshotId so validation can detect a changed market snapshot."
          },
          "side": { "type": "string", "enum": ["LONG", "SHORT"] },
          "entry": { "type": "number", "exclusiveMinimum": 0 },
          "stop": { "type": "number", "exclusiveMinimum": 0 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "maxLossUsdt": { "type": "number", "exclusiveMinimum": 0 },
          "riskPercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "entryOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "exitOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "expectedFundingPeriods": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "default": 0
          },
          "sizeMode": {
            "type": "string",
            "enum": [
              "MARGIN_USDT",
              "QUANTITY_BTC",
              "NOTIONAL_USDT",
              "MAX_LOSS_USDT"
            ]
          },
          "sizeValue": { "type": "number", "exclusiveMinimum": 0 },
          "leverage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150,
            "default": 10
          },
          "marginMode": { "type": "string", "const": "ISOLATED" }
        }
      },
      "PlanValidationResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "quantity": { "type": ["number", "null"] },
          "maxLoss": { "type": ["number", "null"] },
          "estimatedMaxLoss": { "type": ["number", "null"] },
          "notional": { "type": ["number", "null"] },
          "initialMargin": { "type": ["number", "null"] },
          "requestedQuantity": { "type": "number" },
          "estimatedLiquidationPrice": { "type": ["number", "null"] },
          "liquidationDistancePercent": { "type": ["number", "null"] },
          "maximumAllowed": {
            "type": "object",
            "additionalProperties": true
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "calculationSource": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "DecisionRecord": {
        "type": "object",
        "required": [
          "decisionId",
          "snapshotId",
          "marketGeneratedAt",
          "intent",
          "decision",
          "side",
          "analysisMode",
          "instructionVersion",
          "contextPackVersion",
          "confidenceBand",
          "planValidation",
          "targets",
          "reasonTags",
          "counterThesisTags"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "maxLength": 100,
            "description": "Unique id for this exact GPT decision. Reuse only when retrying the identical record request."
          },
          "snapshotId": {
            "type": "string",
            "maxLength": 100,
            "description": "snapshotId returned by the getLatestSnapshot call used for this analysis."
          },
          "marketGeneratedAt": {
            "type": "integer",
            "description": "generatedAt returned by the same getLatestSnapshot response."
          },
          "parentDecisionId": {
            "type": ["string", "null"],
            "maxLength": 100,
            "description": "Known prior decision id when this is an explicit reanalysis; otherwise null."
          },
          "intent": {
            "type": "string",
            "enum": ["MARKET_ANALYSIS", "NEW_ENTRY", "POSITION_MANAGEMENT"]
          },
          "decision": {
            "type": "string",
            "enum": [
              "ENTER_NOW",
              "WAIT_TRIGGER",
              "NO_TRADE",
              "HOLD",
              "PARTIAL_EXIT",
              "EXIT",
              "MOVE_STOP",
              "CHANGE_TP",
              "DATA_BLOCKED"
            ]
          },
          "side": {
            "type": "string",
            "enum": ["LONG", "SHORT", "NEUTRAL"]
          },
          "analysisMode": {
            "type": "string",
            "enum": ["FAST", "VERIFY", "DEEP"]
          },
          "instructionVersion": {
            "type": "string",
            "maxLength": 80
          },
          "contextPackVersion": {
            "type": "string",
            "maxLength": 80
          },
          "confidenceBand": {
            "type": "string",
            "enum": ["NONE", "LOW", "MEDIUM", "HIGH"]
          },
          "planValidation": {
            "type": "string",
            "enum": ["NOT_APPLICABLE", "NOT_RUN", "VALIDATED", "BLOCKED"]
          },
          "entry": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "stop": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "targets": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "triggerSummary": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Short machine-useful trigger summary, not hidden chain-of-thought."
          },
          "invalidationSummary": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Short machine-useful invalidation summary, not hidden chain-of-thought."
          },
          "reasonTags": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "maxLength": 60 },
            "description": "Short structured factual tags only."
          },
          "counterThesisTags": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 60 }
          }
        },
        "additionalProperties": false
      },
      "DecisionRecordResult": {
        "type": "object",
        "required": [
          "ok",
          "decisionId",
          "duplicate",
          "snapshotStatus",
          "recordedAt",
          "snapshotToRecordLatencyMs"
        ],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "decisionId": { "type": "string" },
          "duplicate": { "type": "boolean" },
          "snapshotStatus": {
            "type": "string",
            "enum": ["CURRENT", "SUPERSEDED"]
          },
          "recordedAt": { "type": "integer" },
          "snapshotToRecordLatencyMs": { "type": "integer" }
        },
        "additionalProperties": false
      }
    }
  },
  "security": [{ "actionKey": [] }],
  "paths": {
    "/v1/snapshot/latest": {
      "get": {
        "operationId": "getLatestSnapshot",
        "summary": "Get the latest validated BTCUSDT snapshot",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Latest snapshot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MarketSnapshot" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No snapshot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/context/latest": {
      "get": {
        "operationId": "getExternalContext",
        "summary": "Get normalized external context",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["INTRADAY", "SWING", "MACRO"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "External context",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExternalContext" }
              }
            }
          },
          "400": {
            "description": "Invalid horizon",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No context",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/plan/validate": {
      "post": {
        "operationId": "validateTradePlan",
        "summary": "Validate an exact-size 1 to 150x isolated manual plan",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TradePlan" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated calculation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid plan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationFailure" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Current snapshot cannot validate this plan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationFailure" }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/trading-state/latest": {
      "get": {
        "operationId": "getTradeLifecycle",
        "summary": "Get the latest manual or paper lifecycle state",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Lifecycle state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TradingState" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No trading state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/decision/record": {
      "post": {
        "operationId": "recordDecision",
        "summary": "Record the structured result of the current GPT trading decision for later evaluation",
        "description": "Analytics-only write. Records a decision made from a specific market snapshot. This endpoint cannot place, modify, or cancel exchange orders or change account state.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DecisionRecord" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent retry of an already stored identical decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionRecordResult"
                }
              }
            }
          },
          "201": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionRecordResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid decision payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Action API key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Missing snapshot, metadata mismatch, or conflicting reuse of decisionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Telemetry rate limit exceeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Telemetry storage unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  }
}
