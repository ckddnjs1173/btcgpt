{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Actions",
    "version": "4.0.0",
    "description": "Read-only BTCUSDT Phase 8 scalp data, Phase 9 paper plans, Phase 10 live-manual context, and deterministic validation."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "TradePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "entry",
          "stop",
          "targets",
          "sizeMode",
          "sizeValue",
          "leverage",
          "marginMode"
        ],
        "properties": {
          "side": { "type": "string", "enum": ["LONG", "SHORT"] },
          "entry": { "type": "number", "exclusiveMinimum": 0 },
          "stop": { "type": "number", "exclusiveMinimum": 0 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "maxLossUsdt": { "type": "number", "exclusiveMinimum": 0 },
          "riskPercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "entryOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "exitOrderType": {
            "type": "string",
            "enum": ["MAKER", "TAKER"],
            "default": "TAKER"
          },
          "expectedFundingPeriods": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "default": 0
          },
          "sizeMode": {
            "type": "string",
            "enum": ["MARGIN_USDT", "QUANTITY_BTC", "NOTIONAL_USDT", "MAX_LOSS_USDT"]
          },
          "sizeValue": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Exact user value for the selected sizing mode. It is never silently changed."
          },
          "leverage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150,
            "default": 10
          },
          "marginMode": { "type": "string", "const": "ISOLATED" }
        }
      }
    }
  },
  "security": [{ "actionKey": [] }],
  "paths": {
    "/v1/snapshot/latest": {
      "get": {
        "operationId": "getLatestSnapshot",
        "summary": "Get the latest validated BTCUSDT snapshot",
        "x-openai-isConsequential": false,
        "responses": {
          "200": { "description": "Latest snapshot" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "No snapshot" }
        }
      }
    },
    "/v1/context/latest": {
      "get": {
        "operationId": "getExternalContext",
        "summary": "Get normalized external risk context for a requested horizon",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "description": "INTRADAY for current event risk, SWING for multi-day context, or MACRO for 30 to 90 day scenarios.",
            "schema": {
              "type": "string",
              "enum": ["INTRADAY", "SWING", "MACRO"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Normalized context with source health" },
          "400": { "description": "Invalid horizon" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "No external context" }
        }
      }
    },
    "/v1/plan/validate": {
      "post": {
        "operationId": "validateTradePlan",
        "summary": "Validate an exact-size 1 to 150x isolated manual trade plan",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TradePlan" }
            }
          }
        },
        "responses": {
          "200": { "description": "Validated calculation" },
          "400": { "description": "Invalid plan" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
