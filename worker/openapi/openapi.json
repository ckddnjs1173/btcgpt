{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Actions",
    "version": "5.0.0",
    "description": "Read-only BTCUSDT schema v5 market gates, external context, manual trade lifecycle, and deterministic plan validation."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "WebSocketConnectionHealth": {
        "type": "object",
        "required": ["status", "connected", "lastConnectedAt", "lastEventAt", "reconnectCount", "consecutiveFailures", "errorCode"],
        "properties": {
          "status": { "type": "string", "enum": ["CONNECTED", "DISCONNECTED"] },
          "connected": { "type": "boolean" },
          "lastConnectedAt": { "type": ["integer", "null"] },
          "lastEventAt": { "type": ["integer", "null"] },
          "reconnectCount": { "type": "integer", "minimum": 0 },
          "consecutiveFailures": { "type": "integer", "minimum": 0 },
          "errorCode": { "type": ["string", "null"] }
        }
      },
      "DecisionGates": {
        "type": "object",
        "required": ["marketAnalysisAvailable", "entryAllowed", "positionManagementAvailable", "quality", "generatedAt", "publishedAt", "ageMs", "marketDataAgeMs", "relayPublishAgeMs", "criticalBlockers", "degradedSources", "missingFields"],
        "properties": {
          "marketAnalysisAvailable": { "type": "boolean" },
          "entryAllowed": { "type": "boolean" },
          "positionManagementAvailable": { "type": "boolean" },
          "quality": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
          "generatedAt": { "type": "integer" },
          "publishedAt": { "type": ["integer", "null"] },
          "ageMs": { "type": "number" },
          "marketDataAgeMs": { "type": "number" },
          "relayPublishAgeMs": { "type": ["number", "null"] },
          "criticalBlockers": { "type": "array", "items": { "type": "string" } },
          "degradedSources": { "type": "array", "items": { "type": "string" } },
          "missingFields": { "type": "array", "items": { "type": "string" } }
        }
      },
      "SourceHealth": {
        "type": "object",
        "required": ["status", "eventTime", "receivedTime", "ageMs", "lastSuccess", "consecutiveFailures", "reconnectCount", "validationError"],
        "properties": {
          "status": { "type": "string", "enum": ["INITIALIZING", "NORMAL", "DELAYED", "STALE", "DISCONNECTED", "INSUFFICIENT_DATA"] },
          "eventTime": { "type": ["integer", "null"] },
          "receivedTime": { "type": ["integer", "null"] },
          "ageMs": { "type": "number" },
          "lastSuccess": { "type": ["integer", "null"] },
          "consecutiveFailures": { "type": "integer", "minimum": 0 },
          "reconnectCount": { "type": "integer", "minimum": 0 },
          "validationError": { "type": ["string", "null"] }
        }
      },
      "MarketSnapshot": {
        "type": "object",
        "required": ["schemaVersion", "appVersion", "generatedAt", "decisionGates", "connections", "orderFlow", "sourceHealth"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 5 },
          "appVersion": { "type": "string", "const": "0.5.5" },
          "generatedAt": { "type": "integer" },
          "decisionGates": { "$ref": "#/components/schemas/DecisionGates" },
          "connections": {
            "type": "object",
            "required": ["publicWebSocket", "marketWebSocket"],
            "properties": {
              "publicWebSocket": { "$ref": "#/components/schemas/WebSocketConnectionHealth" },
              "marketWebSocket": { "$ref": "#/components/schemas/WebSocketConnectionHealth" }
            }
          },
          "orderFlow": {
            "type": "object",
            "required": ["orderBookSynchronized", "orderBookSyncState", "orderBookLevelCount"],
            "properties": {
              "orderBookSynchronized": { "type": "boolean" },
              "orderBookSyncState": {
                "type": "string",
                "enum": ["FETCHING_SNAPSHOT", "WAITING_FOR_BRIDGE", "SYNCHRONIZED", "RETRY_SCHEDULED"]
              },
              "orderBookLevelCount": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          },
          "sourceHealth": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/SourceHealth" }
          }
        },
        "additionalProperties": true
      },
      "TradePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "entry",
          "stop",
          "targets",
          "sizeMode",
          "sizeValue",
          "leverage",
          "marginMode"
        ],
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "LONG",
              "SHORT"
            ]
          },
          "entry": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stop": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "maxLossUsdt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "riskPercent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "entryOrderType": {
            "type": "string",
            "enum": [
              "MAKER",
              "TAKER"
            ],
            "default": "TAKER"
          },
          "exitOrderType": {
            "type": "string",
            "enum": [
              "MAKER",
              "TAKER"
            ],
            "default": "TAKER"
          },
          "expectedFundingPeriods": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "default": 0
          },
          "sizeMode": {
            "type": "string",
            "enum": [
              "MARGIN_USDT",
              "QUANTITY_BTC",
              "NOTIONAL_USDT",
              "MAX_LOSS_USDT"
            ]
          },
          "sizeValue": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Exact user value for the selected sizing mode. It is never silently changed."
          },
          "leverage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150,
            "default": 10
          },
          "marginMode": {
            "type": "string",
            "const": "ISOLATED"
          }
        }
      }
    }
  },
  "security": [
    {
      "actionKey": []
    }
  ],
  "paths": {
    "/v1/snapshot/latest": {
      "get": {
        "operationId": "getLatestSnapshot",
        "summary": "Get the latest validated BTCUSDT snapshot",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Latest snapshot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MarketSnapshot" }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "No snapshot"
          }
        }
      }
    },
    "/v1/context/latest": {
      "get": {
        "operationId": "getExternalContext",
        "summary": "Get normalized external risk context for a requested horizon",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "description": "INTRADAY for current event risk, SWING for multi-day context, or MACRO for 30 to 90 day scenarios.",
            "schema": {
              "type": "string",
              "enum": [
                "INTRADAY",
                "SWING",
                "MACRO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized context with source health"
          },
          "400": {
            "description": "Invalid horizon"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "No external context"
          }
        }
      }
    },
    "/v1/plan/validate": {
      "post": {
        "operationId": "validateTradePlan",
        "summary": "Validate an exact-size 1 to 150x isolated manual trade plan",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TradePlan"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated calculation"
          },
          "400": {
            "description": "Invalid plan"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/trading-state/latest": {
      "get": {
        "operationId": "getTradeLifecycle",
        "summary": "Get the latest manual or paper trade lifecycle and position-management state",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Latest trade lifecycle and management state"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "No trading state"
          }
        }
      }
    }
  }
}
