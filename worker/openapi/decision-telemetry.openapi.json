{
  "openapi": "3.1.0",
  "info": {
    "title": "BTC Futures Assistant Decision Telemetry",
    "version": "1.0.0",
    "description": "Analytics-only Action for recording structured GPT trading decisions. It never creates, modifies, or cancels exchange orders."
  },
  "servers": [
    {
      "url": "https://btc-futures-assistant-relay.btcgpt-ck1173.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DecisionRecord": {
        "type": "object",
        "required": [
          "decisionId",
          "snapshotId",
          "marketGeneratedAt",
          "intent",
          "decision",
          "side",
          "analysisMode",
          "instructionVersion",
          "contextPackVersion",
          "confidenceBand",
          "planValidation",
          "targets",
          "reasonTags",
          "counterThesisTags"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "maxLength": 100,
            "description": "Unique id for this exact GPT decision. Reuse the same id only when retrying the same record."
          },
          "snapshotId": {
            "type": "string",
            "maxLength": 100,
            "description": "snapshotId returned by the getLatestSnapshot call used for this analysis."
          },
          "marketGeneratedAt": {
            "type": "integer",
            "description": "generatedAt returned by the same getLatestSnapshot response."
          },
          "parentDecisionId": {
            "type": ["string", "null"],
            "maxLength": 100,
            "description": "Prior decision id when this is an explicit reanalysis of a known earlier decision; otherwise null."
          },
          "intent": {
            "type": "string",
            "enum": ["MARKET_ANALYSIS", "NEW_ENTRY", "POSITION_MANAGEMENT"]
          },
          "decision": {
            "type": "string",
            "enum": [
              "ENTER_NOW",
              "WAIT_TRIGGER",
              "NO_TRADE",
              "HOLD",
              "PARTIAL_EXIT",
              "EXIT",
              "MOVE_STOP",
              "CHANGE_TP",
              "DATA_BLOCKED"
            ]
          },
          "side": {
            "type": "string",
            "enum": ["LONG", "SHORT", "NEUTRAL"]
          },
          "analysisMode": {
            "type": "string",
            "enum": ["FAST", "VERIFY", "DEEP"]
          },
          "instructionVersion": {
            "type": "string",
            "maxLength": 80
          },
          "contextPackVersion": {
            "type": "string",
            "maxLength": 80
          },
          "confidenceBand": {
            "type": "string",
            "enum": ["NONE", "LOW", "MEDIUM", "HIGH"]
          },
          "planValidation": {
            "type": "string",
            "enum": ["NOT_APPLICABLE", "NOT_RUN", "VALIDATED", "BLOCKED"]
          },
          "entry": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "stop": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "targets": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "triggerSummary": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Short machine-useful trigger summary, not hidden chain-of-thought."
          },
          "invalidationSummary": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Short machine-useful invalidation summary, not hidden chain-of-thought."
          },
          "reasonTags": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "maxLength": 60 },
            "description": "Short structured factual tags only, for example CVD_CONFIRMATION or COUNTER_TREND."
          },
          "counterThesisTags": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 60 }
          }
        },
        "additionalProperties": false
      },
      "DecisionRecordResult": {
        "type": "object",
        "required": [
          "ok",
          "decisionId",
          "duplicate",
          "snapshotStatus",
          "recordedAt",
          "snapshotToRecordLatencyMs"
        ],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "decisionId": { "type": "string" },
          "duplicate": { "type": "boolean" },
          "snapshotStatus": {
            "type": "string",
            "enum": ["CURRENT", "SUPERSEDED"]
          },
          "recordedAt": { "type": "integer" },
          "snapshotToRecordLatencyMs": { "type": "integer" }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "message": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/v1/decision/record": {
      "post": {
        "operationId": "recordDecision",
        "summary": "Record the structured result of the current GPT market decision for later evaluation.",
        "description": "Analytics-only write. Record the decision made from a specific market snapshot. This endpoint has no Binance credentials and cannot place, modify, cancel, fund, transfer, or change leverage for any order or account.",
        "security": [{ "actionKey": [] }],
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DecisionRecord" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent retry of an already stored identical decision.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DecisionRecordResult" }
              }
            }
          },
          "201": {
            "description": "Decision recorded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DecisionRecordResult" }
              }
            }
          },
          "400": {
            "description": "Invalid decision payload.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Action API key.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Missing snapshot, metadata mismatch, or conflicting reuse of decisionId.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "Request body too large.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Telemetry rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Telemetry storage unavailable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  }
}
