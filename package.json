{
  "name": "btc-futures-assistant",
  "productName": "BTC Futures Assistant",
  "version": "0.5.6",
  "description": "Local, manual-order BTCUSDT futures monitoring assistant",
  "author": "BTC Futures Assistant",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sqlite": "node scripts/sqlite-smoke.cjs",
    "test:migrations": "node scripts/d1-migration-validate.mjs",
    "test:lead-lag": "node --test scripts/lead-lag-lib.test.mjs",
    "test:evidence-ablation": "node --test scripts/evidence-ablation-lib.test.mjs",
    "test:evidence-ablation-report": "node --test scripts/evidence-ablation-report-lib.test.mjs",
    "test:frozen-context-audit": "node --test scripts/frozen-context-audit-lib.test.mjs",
    "test:production-deploy": "node --test scripts/production-deploy-command.test.mjs",
    "e2e": "vitest run tests/e2e && playwright test",
    "e2e:electron": "playwright test",
    "test:security": "vitest run tests/security",
    "test:soak": "vitest run tests/soak",
    "test:binance-smoke": "node scripts/binance-public-smoke.mjs",
    "test:relay-app-soak": "node scripts/relay-app-soak-monitor.mjs",
    "test:decision-context-soak": "node scripts/decision-context-soak-monitor.mjs",
    "replay:run": "node scripts/replay-runner.mjs",
    "replay:campaign:prepare": "node scripts/replay-campaign-prepare.mjs",
    "replay:batch:prepare": "node scripts/replay-batch-prepare.mjs",
    "replay:batch:ingest": "node scripts/replay-batch-ingest.mjs",
    "research:report": "node scripts/research-report.mjs",
    "research:lead-lag": "node scripts/lead-lag-research.mjs",
    "research:ablation:prepare": "node scripts/evidence-ablation-prepare.mjs",
    "research:ablation:report": "node scripts/evidence-ablation-report.mjs",
    "research:context-audit": "node scripts/frozen-context-audit.mjs",
    "ops:preflight": "node scripts/production-preflight.mjs",
    "ops:deploy": "node scripts/production-deploy.mjs",
    "ops:postdeploy-smoke": "node scripts/production-postdeploy-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:sqlite && npm run test:migrations && npm run test:lead-lag && npm run test:evidence-ablation && npm run test:evidence-ablation-report && npm run test:frozen-context-audit && npm run test:production-deploy && node scripts/production-preflight.mjs --ci"
  },
  "keywords": [
    "bitcoin",
    "futures",
    "electron",
    "local-first"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "lightweight-charts": "4.0.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.2.0",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
